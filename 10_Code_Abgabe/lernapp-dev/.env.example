# Nach .env.local, .env.development oder .env.production kopieren.
# Ausgefüllte .env-Dateien sind gitignored. Keine Secrets committen.
# Die Werkzeuge lesen dotenv als Daten, nicht als Shell-Code.

# Frontend / lokale Login-Beispiele. Für db:start nicht erforderlich.
# Lokal: URL und öffentlichen Key aus npm run db:status übernehmen.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Remote-Werkzeuge: jeweils Werte des ausgewählten Projekts eintragen.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Optional für env(...)-Referenzen in supabase/environments/*.auth.json.
# Beispiele und Feldnamen: docs/environments.md.
# Frontend-Basisadresse ohne Pfad; Staging/Produktion: tatsächliche HTTPS-Domain.
# Daraus entstehen /auth/callback, /auth/confirm und /auth/reset-password automatisch.
AUTH_SITE_URL=
# Optional: zusätzliche erlaubte URLs, kommagetrennt. Standardrouten bleiben enthalten.
AUTH_REDIRECT_URLS=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_SECRET=
# Eigenen SMTP-Versand nur mit true konfigurieren. Gilt für Development und Produktion.
# Bei false werden SMTP-Werte ignoriert; vorhandene Remote-Einstellungen bleiben erhalten.
AUTH_SMTP_ENABLED=false
AUTH_SMTP_PASS=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_ADMIN_EMAIL=
AUTH_SMTP_SENDER_NAME=Lernapp
