# Nach supabase/functions/.env kopieren; lokal durch functions serve geladen.
# Remote als Edge-Function-Secrets konfigurieren. Nie ans Frontend ausliefern.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Visuelle Extraktion markierter PDF-Seiten, unabhängig vom Chatmodell.
# Mistral ist als späterer Adapter vorgesehen, aber noch nicht unterstützt.
DOCUMENT_EXTRACTION_PROVIDER=gemini
GEMINI_DOCUMENT_MODEL=gemini-3.6-flash
DOCUMENT_MAX_OUTPUT_TOKENS=16384

# Nur den Antwortanbieter wechseln. Kein automatischer Fallback.
ANSWER_PROVIDER=gemini
OPENAI_ANSWER_MODEL=gpt-4o-mini
# Vor ANSWER_PROVIDER=gemini ein im eigenen Projekt verfügbares Modell eintragen.
GEMINI_ANSWER_MODEL=
AI_MAX_OUTPUT_TOKENS=800
AI_QUESTIONS_PER_MINUTE=6
AI_CONCURRENT_RESPONSES_PER_USER=1

# Gemini-Index: gemeinsam mit Migration 20260916120000 ausrollen.
# Abweichende Werte werden vor Provider-Aufrufen abgewiesen.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536

# PDF pipeline v2; new jobs pin these settings in their checkpoint.
# DEFAULT omits the API setting for comparison with the previous behavior.
DOCUMENT_PIPELINE_REVISION=pipeline-v2
DOCUMENT_THINKING_LEVEL=LOW
DOCUMENT_MEDIA_RESOLUTION=MEDIUM
DOCUMENT_VISUAL_CONCURRENCY=3
DOCUMENT_WORKER_BUDGET_MS=75000
DOCUMENT_VISUAL_MAX_PAGES=100
DOCUMENT_INDEX_MAX_BATCHES=313
# Global concurrency/quota: public.document_provider_limits (service-role only).
# See docs/document-pipeline-performance.md before changing quotas or rolling back.

# Stripe (Abo „UniVerse Pro“). Nur serverseitig, nie ans Frontend.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Erst nach dem Deployment und dem Anlegen des Webhook-Endpoints im Stripe-Dashboard
# (Signing Secret whsec_...). Lokal: stripe listen --forward-to .../functions/v1/stripe-webhook
STRIPE_WEBHOOK_SECRET=
# Basis-URL der Web-App für Rücksprung-Links (Checkout/Portal), z. B. https://universe.example
APP_URL=
# Widerrufs-Zustimmung beim Checkout verpflichtend machen (true), sobald das Frontend
# `waiver_accepted` mitschickt. Bis dahin wird sie nur protokolliert, wenn vorhanden.
CHECKOUT_REQUIRE_WAIVER=false

# Öffentliche Supabase-URL für Download-Links im Datenexport (account-export).
# Remote nicht nötig (SUPABASE_URL ist dort öffentlich), lokal http://127.0.0.1:54321.
PUBLIC_SUPABASE_URL=

# Zusammenfassungen verwenden ANSWER_PROVIDER; Modell optional separat festlegen.
SUMMARY_MODEL=
SUMMARY_MAX_OUTPUT_TOKENS=3000
SUMMARY_MAX_SOURCE_CHARACTERS=500000
SUMMARY_MAX_CALLS=200
SUMMARY_TOKEN_BUDGET=2000000
